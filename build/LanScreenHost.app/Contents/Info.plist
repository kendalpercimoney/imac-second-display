<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>LanScreenHost</string>
    <key>CFBundleIdentifier</key>
    <string>com.lanscreen.host</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>LanScreen Host</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!--
      Lives in the menu bar, so no Dock icon. The delegate flips the activation
      policy back to regular for as long as the settings window is open, which
      is what gives that window a real Edit menu (and therefore Paste).
    -->
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!--
      There is no Info.plist usage-description key for Screen Recording on
      macOS. TCC prompts on the first SCShareableContent call and the grant is
      managed in System Settings > Privacy & Security > Screen Recording.
      What does matter is that this is a real .app with a stable bundle ID and
      a signature, which is what build_app.sh produces.

      No entitlements file is used, so the app is unsandboxed. A sandboxed app
      cannot open a raw UDP socket to an arbitrary host without the
      com.apple.security.network.client entitlement, and screen capture plus
      sandbox is a fight not worth having for a LAN tool.
    -->
</dict>
</plist>
